# 백엔드 API 주소. 브라우저가 아니라 서버(Server Action, Route Handler)에서만 사용한다.
BACKEND_API_URL=http://localhost:8080

# 이 프론트엔드 자신의 공개 주소. OAuth redirect_uri를 만드는 데 쓰인다 (예: 배포 시 https://project-guard.example.com).
OAUTH_BASE_URL=http://localhost:3000

# 백엔드 backend/.env.example의 INTERNAL_SYNC_SECRET과 반드시 같은 값이어야 한다.
# 소셜 로그인 콜백을 처리한 이 프론트엔드가 백엔드 /api/auth/oauth-sync를 호출할 때 신원을 증명하는 값.
INTERNAL_SYNC_SECRET=

# 구글 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급)
# 승인된 리디렉션 URI: {OAUTH_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 카카오 로그인에서 발급)
# Redirect URI: {OAUTH_BASE_URL}/api/oauth/kakao/callback
# 카카오 로그인 활성화 및 동의항목에서 "카카오계정(이메일)" 필수 동의로 설정해야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 로그인 (Naver Developers > 애플리케이션 등록에서 발급)
# Callback URL: {OAUTH_BASE_URL}/api/oauth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
