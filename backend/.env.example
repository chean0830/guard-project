# data.go.kr 공통 계정 인증키 (실거래가 API, 건축물대장 API가 같은 키를 공유)
DATA_GO_KR_API_KEY=

# 국토교통부 아파트매매 실거래자료
MOLIT_APT_TRADE_ENDPOINT=https://apis.data.go.kr/1613000/RTMSDataSvcAptTradeDev

# 국토교통부 오피스텔 매매 실거래자료
MOLIT_OFFICETEL_TRADE_ENDPOINT=https://apis.data.go.kr/1613000/RTMSDataSvcOffiTrade

# 국토교통부 연립다세대 매매 실거래자료
MOLIT_VILLA_TRADE_ENDPOINT=https://apis.data.go.kr/1613000/RTMSDataSvcRHTrade

# 국토교통부 건축HUB 건축물대장정보 서비스
BUILDING_REGISTER_ENDPOINT=https://apis.data.go.kr/1613000/BldRgstHubService

# 도로명주소 검색 API (juso.go.kr)
JUSO_ADDRESS_API_KEY=

# Google Cloud Vision OCR (카메라 촬영 이미지 텍스트 추출용)
# 서비스 계정 JSON 키 파일의 경로 (파일 자체는 backend/credentials/ 폴더에 두고 git에 올리지 않음)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision-key.json

# 소셜 로그인(구글/카카오/네이버) 콜백 검증은 프론트엔드(Next.js)에서 하고, 그 결과만
# POST /api/auth/oauth-sync로 이 서버에 전달한다. 프론트엔드의 같은 값과 일치해야 하며,
# 아무나 알 수 없는 무작위 문자열이어야 한다 (openssl rand -hex 32 등으로 생성).
INTERNAL_SYNC_SECRET=

# 관리자 로그인 계정. 관리자 화면(/admin/login)에서 이 이메일/비밀번호로 로그인하면
# 관리자 세션이 발급된다. 둘 중 하나라도 비어 있으면 관리자 로그인은 항상 실패한다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 관리자 API(/api/admin/**)를 브라우저 없이 서버/스크립트(e2e 테스트 준비 등)에서 호출할 때
# X-Admin-Secret 헤더로 쓰는 값 (openssl rand -hex 32 등으로 생성, 외부에 노출되지 않도록 주의).
ADMIN_SECRET=

# 개발용 고정 테스트 계정. 값이 있으면 서버 시작 시 일반 회원 1명과 승인 완료된 변호사 1명을
# 자동으로 만든다(인메모리 H2라 재시작마다 사라지기 때문). 배포 환경에서는 비워둘 것.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_LAWYER_EMAIL=
SEED_LAWYER_PASSWORD=

# 회원이 상담 문의를 보내면 매칭된 변호사의 등록 이메일로 알림 메일을 보낸다. 비워두면
# 발송을 건너뛰고 경고 로그만 남긴다(앱 동작에는 영향 없음). Gmail을 쓴다면 일반 비밀번호가
# 아니라 "앱 비밀번호"를 발급받아 써야 한다 (구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 변호사가 답장을 보내면 회원의 브라우저(웹 푸시)로 알림을 보낸다. `npx web-push
# generate-vapid-keys`로 발급하며, 공개키는 프론트엔드가 구독을 만들 때도 필요하다
# (백엔드 GET /api/push/vapid-public-key로 노출, 비밀은 아니라 그대로 내려줘도 안전함).
# VAPID_SUBJECT는 mailto: 주소 또는 https:// URL 형식이어야 한다(웹 푸시 표준 요구사항).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com

# 상담 채팅 WebSocket 접속을 허용할 프론트엔드 주소(Origin). 다른 사이트가 사용자 브라우저로
# 몰래 접속하는 것을 막는다. 배포 시에는 실제 프론트엔드 주소로 바꿔야 한다.
FRONTEND_ORIGIN=http://localhost:3000

# 토스페이먼츠 결제 승인 시크릿 키 (토스페이먼츠 개발자센터 > API 키). 절대 브라우저/저장소에 노출하지 말 것.
# 비어 있으면 결제 승인이 항상 실패한다. 테스트 키(test_sk_...)는 실제 돈이 나가지 않는다.
TOSS_SECRET_KEY=

# 개발 DB 위치. 파일 기반 H2로 두면 서버를 재시작해도 데이터가 남는다(비워두면 재시작마다 초기화되는 인메모리 DB).
# 예: jdbc:h2:file:./data/devdb;AUTO_SERVER=TRUE  — 배포 시에는 PostgreSQL 주소로 바꾼다.
DB_URL=

# [개발용] 메일 설정이 없을 때 비밀번호 재설정 링크를 서버 로그에 남길지. 링크가 곧 계정 열쇠라 운영에서는 false(기본값).
LOG_RESET_LINKS=false

# DB 테이블 자동 변경. 개발은 update, 운영은 validate(스키마 변경은 마이그레이션으로만).
DDL_AUTO=update
